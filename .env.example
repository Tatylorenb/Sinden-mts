# =========================================================================
# APLICACION
# =========================================================================
# Nombre que aparece en la interfaz y en los correos.
APP_NAME=Sinden

# Entorno: local (desarrollo) | production (produccion)
APP_ENV=local

# Clave de la aplicacion. Se genera con: php artisan key:generate
APP_KEY=

# Mostrar errores detallados. En produccion debe estar en false.
APP_DEBUG=true

# URL base del sitio.
APP_URL=http://localhost

# =========================================================================
# LOGS
# =========================================================================
# Canal de logs: stack | single | daily | syslog
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# Nivel minimo: debug | info | warning | error
LOG_LEVEL=debug

# =========================================================================
# BASE DE DATOS
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinden
DB_USERNAME=root
DB_PASSWORD=

# =========================================================================
# DRIVERS DE INFRAESTRUCTURA
# =========================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# Duracion de la sesion en minutos.
SESSION_LIFETIME=120

# =========================================================================
# MEMCACHED (opcional)
# =========================================================================
MEMCACHED_HOST=127.0.0.1

# =========================================================================
# REDIS (opcional)
# =========================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================================
# CORREO
# =========================================================================
# Driver: smtp | sendmail | mailgun | ses | log | array
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@sinden.local"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# AWS S3 (opcional, solo si se usa almacenamiento en la nube)
# =========================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =========================================================================
# PUSHER (opcional, solo si se usa broadcasting en tiempo real)
# =========================================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
